      { "pagePath": "pages/shops/index", "text": "小店", "iconPath": "assets/tab-shops.png", "selectedIconPath": "assets/tab-shops-active.png" },
      { "pagePath": "pages/showcase/index", "text": "宣传", "iconPath": "assets/tab-showcase.png", "selectedIconPath": "assets/tab-showcase-active.png" },
      { "pagePath": "pages/pass/index", "text": "通行证", "iconPath": "assets/tab-pass.png", "selectedIconPath": "assets/tab-pass-active.png" }
    ]
  },
  "usingComponents": {
    "launch-intro": "/components/launch-intro/index",
    "bottom-sheet": "/components/bottom-sheet/index",
    "state-view": "/components/state-view/index",
    "zone-bar": "/components/zone-bar/index",
