    "pages/shops/index", "pages/shops/detail",
    "pages/showcase/index", "pages/showcase/detail", "pages/showcase/publish",
    "pages/pass/index", "pages/pass/auth"
  ],
  "window": {
    "navigationBarTitleText": "蜗壳同路",
    "navigationBarBackgroundColor": "#F7F5F0",
    "navigationBarTextStyle": "black",
