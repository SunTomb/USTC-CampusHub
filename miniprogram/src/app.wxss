page{--bg-canvas:#f7f5f0;--bg-surface:#fff;--bg-subtle:#efece4;--ink:#0b1626;--navy:#16325b;--gold:#c6922c;--gold-soft:#fbf5e6;--text:#141c2b;--secondary:#526075;--muted:#8492a6;--runner:#0d9488;--border:rgba(15,23,42,.09);background:var(--bg-canvas);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.55}
button[class]:not([size="mini"]){width:auto;min-width:0;margin-left:0;margin-right:0}button.primary[disabled]{color:#526075;background:#dce2e9;opacity:1}
view,text,button,input,textarea,scroll-view{box-sizing:border-box}button{font:inherit;border-radius:999rpx;margin:0;line-height:1.3;min-height:80rpx;padding:20rpx 28rpx;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600}button::after{border:0}button[disabled]{opacity:.45;color:#fff;background:var(--navy)}button.plain{background:var(--bg-subtle);color:var(--navy)}button.ghost{background:transparent;color:var(--secondary);border:1rpx solid var(--border)}button.small{min-height:68rpx;padding:14rpx 24rpx;font-size:25rpx}button.danger{color:#b84d34;background:#fff0e9}.page{padding:20rpx 28rpx 40rpx}.with-dock{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.title{font-size:38rpx;line-height:1.35;font-weight:700;letter-spacing:-.5rpx}.heading{font-size:32rpx;line-height:1.4;font-weight:700}.body{font-size:28rpx}.caption{font-size:24rpx;color:var(--secondary)}.muted{color:var(--muted);font-size:24rpx}.mono-num{font-family:"DIN Alternate",monospace;font-variant-numeric:tabular-nums;font-weight:700}.page-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:20rpx}.page-top .muted{margin-top:4rpx}.eyebrow{color:var(--gold);font-size:23rpx;font-weight:600;letter-spacing:2rpx}.section-title{font-weight:700;font-size:29rpx;margin:32rpx 0 16rpx}.row{display:flex;align-items:center;gap:16rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:18rpx}.surface{background:var(--bg-surface);border:1rpx solid var(--border);border-radius:24rpx;padding:28rpx}.pill{display:inline-flex;align-items:center;padding:5rpx 14rpx;border-radius:999rpx;background:var(--bg-subtle);font-size:22rpx;color:var(--secondary);white-space:nowrap}.pill.teal{color:#08766c;background:#ecfdf5}.pill.gold{color:#856018;background:var(--gold-soft)}.pill.blue{color:#1d4ed8;background:#eff6ff}.pill.purple{color:#4338ca;background:#eef2ff}.pill.orange{color:#a84631;background:#fff0e9}.chips{display:flex;flex-wrap:wrap;gap:10rpx}.clamp{overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;word-break:break-word}.single{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.price{color:var(--runner);font-size:40rpx}.error{border-radius:16rpx;background:#fff0e9;color:#99402d;padding:18rpx 22rpx;font-size:26rpx;margin:16rpx 0}.notice{background:var(--gold-soft);color:#795b26;border-radius:16rpx;padding:18rpx 22rpx;font-size:25rpx}.field{margin-bottom:26rpx}.field-label{font-weight:600;margin-bottom:12rpx;font-size:27rpx;display:block}.input,textarea,.picker{width:100%;border:1rpx solid var(--border);border-radius:16rpx;background:#fff;padding:20rpx 22rpx;min-height:88rpx;font-size:28rpx;color:var(--text)}input.input{height:88rpx}textarea{height:200rpx;line-height:1.6}.picker{color:var(--navy)}.form-help{margin-top:10rpx;color:var(--secondary);font-size:23rpx}.form-row{display:flex;gap:16rpx;align-items:flex-start}.form-row>.field{flex:1;min-width:0}.separator{height:1rpx;background:var(--border);margin:24rpx 0}.segmented{display:flex;gap:8rpx;background:var(--bg-subtle);padding:6rpx;border-radius:999rpx;margin:16rpx 0 24rpx}.segment{flex:1;min-height:70rpx;padding:14rpx 10rpx;display:flex;justify-content:center;align-items:center;font-size:25rpx;color:var(--secondary);border-radius:999rpx}.segment.active{background:#fff;color:var(--navy);font-weight:700;box-shadow:0 4rpx 14rpx rgba(11,22,38,.04)}.dock{position:fixed;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid var(--border);z-index:30;display:flex;gap:16rpx}.dock>button{flex:1}.floating{position:fixed;bottom:calc(30rpx + env(safe-area-inset-bottom));right:28rpx;z-index:25;box-shadow:0 12rpx 28rpx rgba(11,22,38,.16);background:var(--navy);min-height:88rpx}.content{white-space:pre-wrap;word-break:break-word;line-height:1.85}.link{color:var(--navy);text-decoration:underline}.action-list{display:flex;flex-direction:column}.action-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;min-height:96rpx;border-bottom:1rpx solid var(--border)}.action-row:last-child{border-bottom:0}.empty-symbol{color:var(--gold);font-size:50rpx}.check-row{display:flex;align-items:flex-start;gap:12rpx;padding:12rpx 0;font-size:25rpx}.check-row checkbox{transform:scale(.85);transform-origin:top left}.safe-bottom{padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.date-grid{display:flex;gap:12rpx}.date-grid>picker{flex:1;min-width:0}.disabled-note{font-size:24rpx;color:var(--secondary);margin:18rpx 0}.badge{display:inline-flex;min-width:32rpx;padding:0 8rpx;justify-content:center;border-radius:999rpx;background:#d95f43;color:#fff;font-size:21rpx}.progress{display:flex;align-items:center;gap:8rpx;margin:16rpx 0}.progress-dot{width:10rpx;height:10rpx;border-radius:50%;background:var(--border)}.progress-dot.active{background:var(--runner)}.pressed{opacity:.78;transform:scale(.99)}
