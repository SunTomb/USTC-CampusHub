<launch-intro id="launch-intro" />
<view class="page with-dock">
  <state-view loading="{{loading}}" error="{{error && !issueOpen ? error : ''}}" bind:retry="reload" />
  <block wx:if="{{task}}">
    <view class="page-top"><text class="pill teal">{{task.statusLabel}}</text><text class="price mono-num">¥{{task.rewardLabel}}</text></view>
    <view class="title">{{task.title}}</view>
    <view class="route-paper"><view class="route-stop"><text class="stop-dot"></text><view><text class="heading">{{task.originLabel}}</text><view class="caption">{{task.originDetail || '具体取件点待双方确认'}}</view></view></view><view class="route-line"></view><view class="route-stop"><text class="stop-dot destination"></text><view><text class="heading">{{task.destinationLabel}}</text><view class="caption">{{task.destinationDetail || '具体送达点待双方确认'}}</view></view></view></view>
    <view class="between caption"><text>{{task.publisherNickname}} 发布</text><text>{{task.deadlineLabel}} 前</text></view>
    <view class="verification-hint">核验方式：{{task.verificationModeLabel}}</view>
    <view class="section-title">委托内容</view><view class="content">{{task.description || "未填写公开说明"}}</view><view class="chips"><text class="pill">重量：{{task.weightLabel}}</text><text wx:if="{{task.notes}}" class="pill">注意：{{task.notes}}</text></view>

    <view wx:if="{{isAssigned || isOwner}}"><view class="section-title">当前履约进度</view><view class="progress-list"><view wx:for="{{progress}}" wx:key="code" class="progress-item {{item.reached ? 'reached' : ''}}"><text class="progress-point"></text><text>{{item.label}}</text><text wx:if="{{item.current}}" class="pill teal">当前</text></view></view><view class="notice">按实际进度更新。{{task.verificationMode === 'COMPLETION_CODE' ? '接单同学在等待确认后输入发布者提供的6位完成码。' : '送达后由发布者确认。'}}</view></view>

    <view wx:if="{{workspace}}" class="workspace"><view wx:if="{{privateDetails && privateDetails.pickupCode}}" class="notice private-details"><text class="heading">私密取件码</text><text selectable>{{privateDetails.pickupCode}}</text></view><view wx:if="{{photos.length}}" class="evidence-card"><view class="section-title">参与方照片</view><view class="media-list"><image wx:for="{{photos}}" wx:key="id" class="evidence-image" data-index="{{index}}" src="{{item.previewPath || item.downloadPath}}" mode="aspectFill" bindtap="previewEvidence"/></view></view>
      <view class="section-title">私下联络</view>
      <view wx:if="{{workspace.publisherContact}}" class="contact-card"><view class="between"><text class="heading">发布者 · {{workspace.publisherContact.nickname}}</text><text class="pill">仅参与者可见</text></view><view wx:for="{{workspace.publisherContact.items}}" wx:key="value" class="contact-row"><text>{{item.label}}：{{item.value}}</text><button class="small ghost" data-value="{{item.value}}" bindtap="copyContact">复制</button></view></view>
      <view wx:if="{{workspace.runnerContact}}" class="contact-card"><view class="between"><text class="heading">接单同学 · {{workspace.runnerContact.nickname}}</text><text class="pill">仅参与者可见</text></view><view wx:for="{{workspace.runnerContact.items}}" wx:key="value" class="contact-row"><text>{{item.label}}：{{item.value}}</text><button class="small ghost" data-value="{{item.value}}" bindtap="copyContact">复制</button></view></view>
      <view wx:if="{{!workspace.runnerContact}}" class="notice">接单人确定后，这里会出现双方联系方式。</view>
      <view class="section-title">履约事件</view><view wx:if="{{workspace.events.length}}" class="event-list"><view wx:for="{{workspace.events}}" wx:key="id" class="event-row"><view class="event-dot"></view><view class="event-main"><view class="between"><text class="heading">{{item.eventTypeLabel}}</text><text class="caption">{{item.createdAtLabel}}</text></view><view class="caption">{{item.actorNickname}}{{item.note ? ' · ' + item.note : ''}}</view></view></view></view><view wx:else class="caption">暂时没有履约事件。</view>
    </view>

    <view wx:if="{{canSubmitEvidence}}" class="verification-card"><view class="heading">送达照片凭证</view><view class="caption">仅发布者与实际接单者可见。请避免上传取件码、证件或无关他人照片。</view><button class="primary" bindtap="chooseEvidence" disabled="{{busy}}">选择并上传照片</button><button wx:if="{{photos.length}}" class="plain" bindtap="submitEvidence" disabled="{{busy}}">提交送达凭证</button></view><view wx:if="{{canGenerateCode}}" class="verification-card"><view class="between"><view><view class="heading">发布完成码</view><view class="caption">有效期30分钟，重新生成会让旧码失效。</view></view><button class="small" bindtap="generateCode" disabled="{{busy}}">{{completionCode ? '重新生成' : '生成完成码'}}</button></view><view wx:if="{{completionCode}}" class="completion-code mono-num">{{completionCode}}</view><view wx:if="{{completionExpiresAt}}" class="caption">有效至 {{completionExpiresAt}}</view></view>
    <view wx:if="{{canRedeemCode}}" class="verification-card"><view class="heading">输入发布者提供的完成码</view><view class="caption">连续输错5次会暂时锁定，发布者重新生成后才可再次尝试。</view><input class="input code-input mono-num" value="{{enteredCompletionCode}}" data-field="enteredCompletionCode" bindinput="field" maxlength="6" type="text" placeholder="6位数字"/><button class="primary" bindtap="redeemCode" loading="{{busy}}" disabled="{{busy}}">核销完成码</button></view>

    <view wx:if="{{isOwner && applicants.length}}"><view class="section-title">报名同学</view><view wx:for="{{applicants}}" wx:key="id" class="applicant"><view class="between"><text class="heading">{{item.applicantNickname}}</text><text class="pill">{{item.statusLabel}}</text></view><view class="content caption">{{item.message || '未附留言'}}</view><button wx:if="{{item.selectable}}" class="small" data-id="{{item.id}}" bindtap="chooseApplicant" disabled="{{busy}}">选择这位同学</button></view></view>
    <view wx:if="{{canIssue}}" class="action-row" bindtap="openIssue"><text>遇到问题</text><text>反馈情况 →</text></view><view class="disabled-note">报酬由双方直接结算。私下联系方式仅在参与者工作区显示，请勿写入公开任务内容。</view>
  </block>
</view>
<view wx:if="{{action || canConfirm}}" class="dock"><button class="primary" wx:if="{{action}}" bindtap="advance" loading="{{busy}}" disabled="{{busy}}">{{action.label}}</button><button class="primary" wx:if="{{canConfirm}}" bindtap="confirmComplete" loading="{{busy}}" disabled="{{busy}}">{{confirmLabel}}</button></view>
<bottom-sheet visible="{{issueOpen}}" title="反馈履约问题" busy="{{busy}}" bind:close="closeIssue"><view class="field"><text class="field-label">问题类型</text><picker range="{{issueTypes}}" range-key="label" value="{{issueIndex}}" data-field="issueIndex" bindchange="field"><view class="picker">{{issueTypes[issueIndex].label}}</view></picker></view><view class="field"><text class="field-label">具体情况</text><textarea value="{{issueDescription}}" data-field="issueDescription" bindinput="field" maxlength="1000" placeholder="说明发生了什么，不要填写与此任务无关的私人资料" /></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer"><button class="primary" bindtap="sendIssue" disabled="{{busy}}" loading="{{busy}}">提交问题</button></view></bottom-sheet>
