.ticket{display:flex;min-height:220rpx;margin-bottom:18rpx;background:#fff;border:1rpx solid var(--border);border-radius:22rpx;box-shadow:0 8rpx 24rpx rgba(11,22,38,.025);overflow:hidden}.ticket-main{width:72%;padding:22rpx;min-width:0}.route{display:flex;align-items:center;gap:10rpx;font-size:26rpx;font-weight:700;color:var(--navy);white-space:nowrap}.route-arrow{color:var(--runner)}.ticket-title{font-size:28rpx;font-weight:600;margin:8rpx 0 6rpx}.ticket-meta{font-size:22rpx;color:var(--secondary)}.mode{font-size:20rpx;color:var(--runner)}.ticket-stub{position:relative;width:28%;border-left:1rpx dashed rgba(15,23,42,.16);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22rpx;padding:16rpx 10rpx}.ticket-stub::before,.ticket-stub::after{content:'';position:absolute;left:-10rpx;width:20rpx;height:20rpx;border-radius:50%;background:var(--bg-canvas)}.ticket-stub::before{top:-10rpx}.ticket-stub::after{bottom:-10rpx}.ticket-price{color:var(--runner);font-size:36rpx}.take-button{align-self:stretch;font-size:23rpx;min-height:68rpx;padding:12rpx 16rpx;background:var(--runner);width:100%}.sheet-description{margin:24rpx 0}.list-foot{text-align:center;margin:30rpx 0}
