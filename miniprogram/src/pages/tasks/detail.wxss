.route-paper{border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border);padding:28rpx 0;margin:28rpx 0 22rpx}.route-stop{display:flex;gap:20rpx;align-items:center}.stop-dot{width:16rpx;height:16rpx;border:4rpx solid var(--runner);border-radius:50%}.stop-dot.destination{border-color:var(--gold)}.route-line{height:35rpx;border-left:1rpx dashed var(--border);margin-left:7rpx}.progress-list{display:flex;flex-direction:column;gap:20rpx;margin:20rpx 0 28rpx}.progress-item{display:flex;align-items:center;gap:18rpx;color:var(--muted);font-size:26rpx}.progress-point{width:14rpx;height:14rpx;background:#e8dfd3;border-radius:50%}.progress-item.reached{color:var(--navy)}.reached .progress-point{background:var(--runner)}.applicant{padding:24rpx 0;border-bottom:1rpx solid var(--border);display:flex;flex-direction:column;gap:18rpx}
.verification-hint{color:var(--secondary);font-size:24rpx;margin:18rpx 0}.workspace{margin-top:34rpx}.contact-card,.verification-card{background:var(--bg-surface);border:1rpx solid var(--border);border-radius:20rpx;padding:22rpx;margin:16rpx 0}.contact-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-top:1rpx solid var(--border);padding-top:16rpx;margin-top:16rpx;font-size:25rpx}.event-list{display:flex;flex-direction:column;gap:18rpx}.event-row{display:flex;gap:16rpx}.event-dot{width:14rpx;height:14rpx;flex:none;border-radius:50%;background:var(--runner);margin-top:10rpx}.event-main{flex:1}.completion-code{font-size:56rpx;letter-spacing:12rpx;color:var(--navy);padding:20rpx 0}.code-input{text-align:center;letter-spacing:10rpx;margin:20rpx 0}

.private-details{display:flex;flex-direction:column;gap:8rpx}.media-list{display:flex;gap:14rpx;flex-wrap:wrap}.evidence-column{width:180rpx;flex:none}.evidence-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:#efe1cf;color:var(--navy);font-size:22rpx}.evidence-placeholder .initial{font:600 58rpx/1.3 serif}.evidence-column image{display:block}.evidence-image{overflow:hidden;width:180rpx;height:180rpx;border-radius:16rpx}

.photo-overlay{position:fixed;top:0;bottom:0;left:0;right:0;z-index:1100;background:#261b14;color:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column}.photo-overlay image{width:100%;height:85%}

.owner-actions{padding:22rpx;margin:24rpx 0;display:grid;gap:12rpx}
