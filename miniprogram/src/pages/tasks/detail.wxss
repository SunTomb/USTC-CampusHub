.route-paper{border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border);padding:28rpx 0;margin:28rpx 0 22rpx}.route-stop{display:flex;gap:20rpx;align-items:center}.stop-dot{width:16rpx;height:16rpx;border:4rpx solid var(--runner);border-radius:50%}.stop-dot.destination{border-color:var(--gold)}.route-line{height:35rpx;border-left:1rpx dashed var(--border);margin-left:7rpx}.progress-list{display:flex;flex-direction:column;gap:20rpx;margin:20rpx 0 28rpx}.progress-item{display:flex;align-items:center;gap:18rpx;color:var(--muted);font-size:26rpx}.progress-point{width:14rpx;height:14rpx;background:#d9dedf;border-radius:50%}.progress-item.reached{color:var(--navy)}.reached .progress-point{background:var(--runner)}.applicant{padding:24rpx 0;border-bottom:1rpx solid var(--border);display:flex;flex-direction:column;gap:18rpx}
.verification-hint{color:var(--secondary);font-size:24rpx;margin:18rpx 0}.workspace{margin-top:34rpx}.contact-card,.verification-card{background:#fff;border:1rpx solid var(--border);border-radius:20rpx;padding:22rpx;margin:16rpx 0}.contact-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-top:1rpx solid var(--border);padding-top:16rpx;margin-top:16rpx;font-size:25rpx}.event-list{display:flex;flex-direction:column;gap:18rpx}.event-row{display:flex;gap:16rpx}.event-dot{width:14rpx;height:14rpx;flex:none;border-radius:50%;background:var(--runner);margin-top:10rpx}.event-main{flex:1}.completion-code{font-size:56rpx;letter-spacing:12rpx;color:var(--navy);padding:20rpx 0}.code-input{text-align:center;letter-spacing:10rpx;margin:20rpx 0}
