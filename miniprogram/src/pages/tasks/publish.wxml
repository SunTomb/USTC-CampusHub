<launch-intro id="launch-intro" />
<view class="page with-dock">
  <view class="title">{{editing ? '修改跑腿委托' : '发一程跑腿'}}</view>
  <view class="step-bar"><view class="{{step === 0 ? 'selected' : ''}}">委托与路线</view><view class="{{step === 1 ? 'selected' : ''}}">{{editing ? '确认修改' : '确认发布'}}</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <state-view wx:if="{{editing && !editReady && !publishedId}}" loading="{{loading}}" error="{{error}}" bind:retry="reload" />
  <block wx:elif="{{step === 0}}">
    <view class="field"><text class="field-label">委托事项</text><input class="input" value="{{form.title}}" data-field="form.title" bindinput="field" maxlength="120" placeholder="例如：从西区驿站取一套教材"/></view>
    <view class="field"><text class="field-label">公开说明（选填）</text><textarea value="{{form.description}}" data-field="form.description" bindinput="field" maxlength="2000" placeholder="说明物品和委托要求，不要填写取件码" /></view>
    <view class="form-row"><view class="field"><text class="field-label">从哪里取</text><picker range="{{zones}}" range-key="label" value="{{originIndex}}" data-field="originIndex" bindchange="field"><view class="picker">{{zones[originIndex].label}}</view></picker></view><view class="field"><text class="field-label">送到哪里</text><picker range="{{zones}}" range-key="label" value="{{destinationIndex}}" data-field="destinationIndex" bindchange="field"><view class="picker">{{zones[destinationIndex].label}}</view></picker></view></view>
    <view class="field"><text class="field-label">取件位置</text><input class="input" value="{{form.originDetail}}" data-field="form.originDetail" bindinput="field" maxlength="200" placeholder="填写公共取件点"/></view>
    <view class="field"><text class="field-label">送达位置</text><input class="input" value="{{form.destinationDetail}}" data-field="form.destinationDetail" bindinput="field" maxlength="200" placeholder="填写约定交接点"/></view>
    <view class="field"><text class="field-label">送达截止时间</text><view class="date-grid"><picker mode="date" value="{{date}}" data-field="date" bindchange="field"><view class="picker">{{date}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="field"><view class="picker">{{time}}</view></picker></view></view>
    <view class="form-row"><view class="field"><text class="field-label">物品重量（公斤，必填）</text><input class="input" type="digit" value="{{form.weightKg}}" data-field="form.weightKg" bindinput="field" placeholder="可估算，例如 0.5"/></view><view class="field"><text class="field-label">报酬（元）</text><input class="input" type="digit" value="{{form.rewardAmount}}" data-field="form.rewardAmount" bindinput="field" placeholder="直接结算"/></view></view>
    <view class="field"><text class="field-label">注意事项（选填，公开）</text><textarea value="{{form.notes}}" data-field="form.notes" bindinput="field" maxlength="1000" placeholder="如：书角易折，请保持干燥。"/></view>
    <view class="section-title">私密取件信息</view><view class="caption private-help">仅任务双方可见</view>
    <view class="field"><text class="field-label">取件码（选填）</text><input class="input" value="{{form.pickupCode}}" data-field="form.pickupCode" bindinput="field" maxlength="120" placeholder="驿站或柜机的取件码，不是送达完成码"/></view>
    <view wx:if="{{editing}}" class="caption">原有照片会保留，可在任务工作区管理参与方照片。</view>
    <view wx:else class="field"><text class="field-label">物品照片（选填）</text><view class="media-list"><view wx:for="{{photos}}" wx:key="key" class="media-item"><image src="{{item.path}}" data-src="{{item.path}}" mode="aspectFill" catchtap="previewDraft"/><button class="small plain" data-key="{{item.key}}" bindtap="removePhoto">移除</button></view></view><button class="plain" wx:if="{{photos.length < 3}}" bindtap="pickPhotos">＋ 选择照片</button><text class="form-help">最多 3 张 JPG / PNG，每张不超过 5 MiB。确认发布后才上传。</text></view>
  </block>
  <block wx:else>
    <view class="surface recap"><text class="heading">{{form.title}}</text><view class="caption">{{zones[originIndex].label}} → {{zones[destinationIndex].label}} · {{form.weightKg}} 公斤</view><view class="caption">{{date}} {{time}} 前</view><view class="price mono-num">¥{{form.rewardAmount}}</view></view>
    <block wx:if="{{!publishedId && !uncertain}}"><text class="field-label">接单方式</text><view class="segmented"><view data-value="GRAB" bindtap="mode" class="segment {{form.acceptanceMode === 'GRAB' ? 'active' : ''}}">即时抢单</view><view data-value="APPLICATION" bindtap="mode" class="segment {{form.acceptanceMode === 'APPLICATION' ? 'active' : ''}}">报名筛选</view></view>
    <text class="field-label">交接方式</text><view class="segmented"><view data-value="PHOTO_AND_CONFIRMATION" bindtap="verification" class="segment {{form.verificationMode === 'PHOTO_AND_CONFIRMATION' ? 'active' : ''}}">送达照片＋确认</view><view data-value="COMPLETION_CODE" bindtap="verification" class="segment {{form.verificationMode === 'COMPLETION_CODE' ? 'active' : ''}}">六位完成码</view></view></block>
    <view wx:if="{{publishedId}}" class="notice">任务 #{{publishedId}} 已保存。待上传 {{photos.length}} 张；重试不会重复发布。</view>
    <view wx:elif="{{uncertain}}" class="notice">未收到发布结果，请先到「个人 → 我的订单」核对发布记录，不要重复下单。</view>
    <view wx:else class="notice">物品照片 {{photos.length}} 张。取件码和照片只在任务工作区展示。</view><view wx:if="{{progress}}" class="caption">{{progress}}</view>
  </block>
</view>
<view wx:if="{{!editing || editReady || publishedId}}" class="dock"><button wx:if="{{step && !publishedId && !uncertain}}" class="plain" bindtap="back" disabled="{{busy}}">修改委托</button><button wx:if="{{!step}}" class="primary" bindtap="next">继续</button><button wx:elif="{{uncertain}}" class="plain" data-url="/pages/orders/index?type=TASK" bindtap="go">查看我的订单</button><block wx:else><button wx:if="{{publishedId}}" class="plain" bindtap="finish" disabled="{{busy}}">查看任务</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{publishedId ? '继续' : editing ? '保存修改' : '确认发布'}}</button></block></view>
