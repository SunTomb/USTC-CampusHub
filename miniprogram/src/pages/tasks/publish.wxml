<launch-intro id="launch-intro" />
<view class="page with-dock"><view class="title">发一程跑腿</view><view class="step-bar"><view class="{{step === 0 ? 'selected' : ''}}">路线</view><view class="{{step === 1 ? 'selected' : ''}}">委托</view><view class="{{step === 2 ? 'selected' : ''}}">确认</view></view><view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:if="{{step === 0}}"><view class="form-row"><view class="field"><text class="field-label">从哪里取</text><picker range="{{zones}}" range-key="label" value="{{originIndex}}" data-field="originIndex" bindchange="field"><view class="picker">{{zones[originIndex].label}}</view></picker></view><view class="field"><text class="field-label">送到哪里</text><picker range="{{zones}}" range-key="label" value="{{destinationIndex}}" data-field="destinationIndex" bindchange="field"><view class="picker">{{zones[destinationIndex].label}}</view></picker></view></view><view class="field"><text class="field-label">取件位置</text><input class="input" value="{{form.originDetail}}" data-field="form.originDetail" bindinput="field" maxlength="200" placeholder="如：东区菜鸟驿站" /></view><view class="field"><text class="field-label">送达位置</text><input class="input" value="{{form.destinationDetail}}" data-field="form.destinationDetail" bindinput="field" maxlength="200" placeholder="如：西区图书馆门口" /></view><text class="muted">填写公共位置即可，勿在此放取件码、房间号或私人电话。</text></view>
<view wx:elif="{{step === 1}}"><view class="field"><text class="field-label">需要帮什么忙</text><input class="input" value="{{form.title}}" data-field="form.title" bindinput="field" maxlength="120" placeholder="如：顺路带两本教材到西区" /></view><view class="field"><text class="field-label">委托说明</text><textarea value="{{form.description}}" data-field="form.description" bindinput="field" maxlength="2000" placeholder="物品大小、注意事项、交接方式" /></view><view class="field"><text class="field-label">悬赏报酬（元）</text><input class="input mono-num" type="digit" value="{{form.rewardAmount}}" data-field="form.rewardAmount" bindinput="field" placeholder="金额由双方直接结算" /></view><view class="field"><text class="field-label">希望何时送达</text><view class="date-grid"><picker mode="date" value="{{date}}" data-field="date" bindchange="field"><view class="picker">{{date}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="field"><view class="picker">{{time}}</view></picker></view></view></view>
<view wx:else><text class="field-label">怎样确定接单同学</text><view class="choice {{form.acceptanceMode === 'GRAB' ? 'chosen' : ''}}" data-value="GRAB" bindtap="mode"><view class="heading">即时抢单</view><text class="caption">先到先得，适合日常顺路小事</text></view><view class="choice {{form.acceptanceMode === 'APPLICATION' ? 'chosen' : ''}}" data-value="APPLICATION" bindtap="mode"><view class="heading">报名后挑选</view><text class="caption">看完留言后，由你选择一位同学</text></view><text class="field-label">怎样确认完成</text><view class="choice {{form.verificationMode === 'PHOTO_AND_CONFIRMATION' ? 'chosen' : ''}}" data-value="PHOTO_AND_CONFIRMATION" bindtap="verification"><view class="heading">发布者确认</view><text class="caption">接单同学送达后，由你确认收到</text></view><view class="choice {{form.verificationMode === 'COMPLETION_CODE' ? 'chosen' : ''}}" data-value="COMPLETION_CODE" bindtap="verification"><view class="heading">6位完成码</view><text class="caption">你生成一次性完成码，接单同学送达后输入核销</text></view><view class="surface recap"><view class="heading">{{form.title}}</view><view class="caption">{{zones[originIndex].label}} → {{zones[destinationIndex].label}}</view><view class="caption">{{date}} {{time}} 前</view><view class="price mono-num">¥{{form.rewardAmount}}</view></view><view class="notice">报酬由双方直接结算，平台不代收、不收保证金；任务公开内容不要填写取件码或私人号码。</view></view>
</view><view class="dock"><button wx:if="{{step > 0}}" class="plain" bindtap="back" disabled="{{busy}}">上一步</button><button class="primary" wx:if="{{step < 2}}" bindtap="next">继续</button><button class="primary" wx:else bindtap="submit" loading="{{busy}}" disabled="{{busy}}">确认发布</button></view>
