.showcase-page{padding-bottom:48rpx}.search-row{display:flex;gap:14rpx;align-items:center}.search-row .input{min-width:0;font-size:25rpx}.type-scroll{margin:22rpx 0 6rpx;width:100%}.type-row{display:flex;gap:12rpx;white-space:nowrap;padding-bottom:10rpx}.type-chip{flex-shrink:0;padding:12rpx 22rpx;border-radius:999rpx;background:var(--bg-subtle);color:var(--secondary);font-size:25rpx}.type-chip.selected{background:var(--navy);color:#fff}.featured-row{display:flex;gap:18rpx;padding-bottom:8rpx}.featured-card{flex:0 0 570rpx;max-width:90%;padding:26rpx;border-radius:22rpx;background:var(--navy);color:#fff;min-height:278rpx;border:1rpx solid rgba(198,146,44,.3);white-space:normal}.featured-kicker{font-size:23rpx;color:#e9dbb9}.featured-seal{font-size:21rpx;color:#edce8c;border:1rpx solid rgba(237,206,140,.5);padding:2rpx 12rpx;border-radius:5rpx}.featured-title{font-size:32rpx;line-height:1.4;font-weight:700;margin:18rpx 0 10rpx}.featured-summary{font-size:24rpx;color:#d7dfe9}.featured-meta{font-size:22rpx;color:#e9dbb9;margin-top:20rpx}.featured-warning{margin-top:18rpx}.list-heading{margin:24rpx 0 16rpx}.list-heading .section-title{margin:0}.poster{border-left:6rpx solid #4338ca}.poster.type-PORTFOLIO{border-left-color:#0d9488}.poster.type-CLUB_RECRUITMENT{border-left-color:var(--gold)}.poster.type-CAMPUS_EVENT{border-left-color:#d95f43}.poster.type-OTHER{border-left-color:var(--secondary)}.poster-title{font-size:31rpx;font-weight:700;line-height:1.4;margin:18rpx 0 12rpx}.poster-summary{margin-bottom:16rpx}.poster-footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8rpx;margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid var(--border);font-size:23rpx;color:var(--secondary)}
