.showcase-page{padding-bottom:48rpx}.search-row{display:flex;gap:14rpx;align-items:center}.search-row .input{min-width:0;font-size:25rpx}.type-scroll{margin:22rpx 0 6rpx;width:100%}.type-row{display:flex;gap:12rpx;white-space:nowrap;padding-bottom:10rpx}.type-chip{flex-shrink:0;padding:12rpx 22rpx;border-radius:999rpx;background:var(--bg-subtle);color:var(--secondary);font-size:25rpx}.type-chip.selected{background:var(--navy);color:#fff}
.featured-row{display:flex;gap:18rpx;padding-bottom:8rpx}
.featured-card{flex:0 0 570rpx;max-width:90%;height:224rpx;padding:18rpx;align-items:center;border-radius:22rpx;color:#fff;background:linear-gradient(135deg,#3c271a,#6b3b20);white-space:normal}
.featured-card .catalog-copy,.poster .catalog-copy{height:100%}.featured-card .between{gap:8rpx}.featured-kicker,.featured-meta{font-size:21rpx;color:#f2dab6;line-height:1.25}.featured-seal{flex:none;font-size:20rpx;color:#f6dfaf;border:1rpx solid #c69968;padding:1rpx 10rpx;border-radius:6rpx}
.featured-title,.poster-title{font-size:30rpx;line-height:1.3;font-weight:700}.featured-summary,.poster-summary{font-size:23rpx;line-height:1.32}.featured-summary{color:#f6eadc}
.featured-warning{margin-top:18rpx}.list-heading{margin:24rpx 0 16rpx}.list-heading .section-title{margin:0}
.poster{height:262rpx;padding:20rpx;align-items:center}.poster-meta,.poster-tags,.poster-footer{line-height:1.3;font-size:22rpx}.poster-meta{display:flex;align-items:center;gap:8rpx}.poster-meta .pill{flex:none}.poster-meta,.poster-tags{color:var(--navy)}.poster-footer{color:var(--secondary)}
