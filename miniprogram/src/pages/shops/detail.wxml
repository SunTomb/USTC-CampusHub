<launch-intro id="launch-intro" />
<view class="page"><state-view loading="{{loading}}" error="{{error && !booking ? error : ''}}" bind:retry="reload"/><block wx:if="{{shop}}">
  <view class="surface catalog-head shop-head">
    <catalog-photos id="shop-thumb" variant="thumb" kind="SHOP" object-id="{{shop.id}}" fallback-char="{{shop.initial}}" tone="{{shop.id % 4}}" />
    <view class="catalog-copy">
      <view class="eyebrow single">{{shop.zoneLabel}} · 同窗工作室</view><view class="title single">{{shop.name}}</view>
      <view class="caption single">{{shop.rating==null?'暂无评分':shop.rating+' 分'}} · 主理人 {{shop.ownerNickname || '同学'}}</view>
      <view class="caption single">{{shop.openingHours || '预约时间可协商'}}</view>
    </view>
  </view>
  <catalog-photos variant="detail" kind="SHOP" object-id="{{shop.id}}" editable="{{user && user.id===shop.ownerId}}" bind:changed="photosChanged" />
  <view class="content shop-description" wx:if="{{shop.description}}">{{shop.description}}</view>
  <view wx:if="{{bookingDone}}" class="notice">预约已发送，可到「个人 → 我的订单 → 预约」查看进度。</view><view class="contacts" wx:if="{{contacts.length}}"><button wx:for="{{contacts}}" wx:key="label" class="small plain" data-index="{{index}}" bindtap="copyContact">{{item.label}}</button></view><view wx:else class="disabled-note">预约后可查看主理人联系方式</view><view class="section-title">这家店能帮你</view>
  <view wx:for="{{services}}" wx:key="id" class="surface service catalog-head" data-url="/pages/shops/item?id={{item.id}}" bindtap="go" hover-class="pressed">
    <catalog-photos variant="thumb" style="--catalog-thumb-size:160rpx" kind="SERVICE_ITEM" object-id="{{item.id}}" fallback-char="{{item.initial}}" tone="{{item.id % 4}}" />
    <view class="catalog-copy">
      <view class="caption single">{{item.categoryLabel}} · 约 {{item.durationMinutes}} 分钟</view>
      <view class="heading single">{{item.title}}</view>
      <view class="caption single">{{item.reviewCount ? item.rating + ' 分 · ' + item.reviewCount + ' 条评价' : '暂无评价'}}</view>
      <view class="caption clamp">{{item.description}}</view>
      <view class="between service-bottom"><view class="single grow"><text class="service-price mono-num">¥{{item.priceLabel}}</text><text class="caption"> / {{item.priceUnit}}</text></view><button class="small appointment" data-id="{{item.id}}" catchtap="openBooking">预约</button></view>
    </view>
  </view>
  <state-view empty="{{!services.length}}" title="主理人正在整理服务" description="目前没有可预约的服务项目。" /><content-report wx:if="{{shop.status==='APPROVED' && (!user || shop.ownerId!==user.id)}}" kind="SHOP" object-id="{{shop.id}}"/></block></view>
<bottom-sheet id="booking-sheet" visible="{{booking}}" title="预约同学的服务" busy="{{busy}}" bind:close="closeBooking"><view class="field"><text class="field-label">选择服务</text><picker range="{{services}}" range-key="title" value="{{serviceIndex}}" data-field="serviceIndex" bindchange="field"><view class="picker">{{services[serviceIndex].title}}</view></picker></view><view class="field"><text class="field-label">期望时间</text><view class="date-grid"><picker mode="date" value="{{date}}" data-field="date" bindchange="field"><view class="picker">{{date}}</view></picker><picker mode="time" value="{{time}}" data-field="time" bindchange="field"><view class="picker">{{time}}</view></picker></view></view><view class="field"><text class="field-label">一句话说说需求</text><textarea value="{{note}}" data-field="note" bindinput="field" maxlength="1000" placeholder="如：电脑型号、约拍风格、方便联系的时段" /></view><view class="notice">参考价 ¥{{services[serviceIndex].priceLabel}} / {{services[serviceIndex].priceUnit}}，费用由双方线下确认结算。</view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submitBooking">发送预约，等待主理人确认</button></view></bottom-sheet>
