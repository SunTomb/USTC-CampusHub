<launch-intro id="launch-intro" />
<view class="page"><view class="page-top"><view><text class="eyebrow">同学的拿手好事</text><view class="title">校园小店</view></view><text class="caption">技能 · 预约</text></view><zone-bar value="{{zone}}" bind:change="changeZone" /><scroll-view scroll-x class="categories" show-scrollbar="{{false}}"><view class="category-inner"><view wx:for="{{categories}}" wx:key="value" class="category {{category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeCategory">{{item.label}}</view></view></scroll-view><view class="search"><input class="input" value="{{keyword}}" data-field="keyword" bindinput="field" bindconfirm="search" confirm-type="search" placeholder="找店铺、服务或擅长的事" /><button class="small plain" bindtap="search">查找</button></view><state-view loading="{{loading}}" error="{{error}}" empty="{{!shops.length}}" title="这里还没有开张的小店" description="换个分类或校区，看看同学的手艺。" bind:retry="reload" />
<view wx:for="{{shops}}" wx:key="id" class="studio"><view class="studio-art" data-id="{{item.id}}" bindtap="detail"><view class="art-circle"></view><view class="art-line"></view><text class="studio-letter">{{item.initial}}</text><text class="studio-zone">{{item.zoneLabel}}</text></view><view class="studio-body"><view class="between"><view class="heading single">{{item.name}}</view><button class="small" data-id="{{item.id}}" bindtap="book">预约</button></view><view class="caption clamp studio-desc">{{item.description}}</view><view wx:for="{{item.previewServices}}" wx:for-item="service" wx:key="id" class="service-preview"><text class="single grow">{{service.title}}</text><text class="mono-num">¥{{service.priceLabel}} / {{service.priceUnit}}</text></view><view class="studio-footer caption"><text>{{item.ownerNickname}}</text><text>{{item.openingHours || '时间可协商'}}</text></view></view></view>
</view>
