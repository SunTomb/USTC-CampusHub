<launch-intro id="launch-intro" />
<view class="page"><view class="page-top"><view><text class="eyebrow">同学的拿手好事</text><view class="title">校园小店</view></view><text class="caption">技能 · 预约</text></view><zone-bar value="{{zone}}" bind:change="changeZone" /><scroll-view scroll-x class="categories" show-scrollbar="{{false}}"><view class="category-inner"><view wx:for="{{categories}}" wx:key="value" class="category {{category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeCategory">{{item.label}}</view></view></scroll-view><view class="search"><input class="input" value="{{keyword}}" data-field="keyword" bindinput="field" bindconfirm="search" confirm-type="search" placeholder="找店铺、服务或擅长的事" /><button class="small plain" bindtap="search">查找</button></view><state-view loading="{{loading}}" error="{{error}}" empty="{{!shops.length}}" title="这里还没有开张的小店" description="换个分类或校区，看看同学的手艺。" bind:retry="reload" />
<view wx:for="{{shops}}" wx:key="id" class="surface studio" data-id="{{item.id}}" bindtap="detail" hover-class="pressed">
  <view class="studio-head catalog-head">
    <catalog-photos variant="thumb" kind="SHOP" object-id="{{item.id}}" fallback-char="{{item.initial}}" tone="{{item.id % 4}}" />
    <view class="catalog-copy">
      <view class="between"><view class="heading single grow">{{item.name}}</view><button class="small appointment" data-id="{{item.id}}" catchtap="book">预约</button></view>
      <view class="studio-desc caption clamp">{{item.description}}</view>
      <view class="caption single">{{item.zoneLabel}} · {{item.rating==null?'暂无评分':item.rating+' 分'}} · {{item.ownerNickname || '主理人'}}</view>
      <view class="caption single">{{item.openingHours || '预约时间可协商'}}</view>
    </view>
  </view>
  <view class="service-previews">
    <view class="service-preview" wx:for="{{item.previewServices}}" wx:for-item="service" wx:key="id">
      <view class="single grow">{{service.title}}</view><view class="single service-amount">¥{{service.priceLabel}} / {{service.priceUnit}}</view>
    </view>
    <view wx:if="{{!item.previewServices.length}}" class="caption single">服务项目整理中</view>
  </view>
</view>
</view>
