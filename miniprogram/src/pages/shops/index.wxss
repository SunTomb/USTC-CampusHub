.categories{white-space:nowrap;margin-bottom:20rpx}.category-inner{display:inline-flex;gap:20rpx}.category{padding:12rpx 4rpx;min-height:70rpx;color:var(--secondary);font-size:25rpx;border-bottom:3rpx solid transparent}.category.active{color:var(--navy);border-color:var(--gold);font-weight:700}.search{display:flex;gap:12rpx;margin:12rpx 0 24rpx}.search input{flex:1;min-width:0}.studio{border:1rpx solid var(--border);border-radius:24rpx;overflow:hidden;background:#fff;margin-bottom:24rpx}.studio-art{height:170rpx;position:relative;overflow:hidden;background:#16325b;color:#fff}.art-circle{width:220rpx;height:220rpx;border:1rpx solid rgba(198,146,44,.6);border-radius:50%;position:absolute;left:80rpx;top:-80rpx}.art-line{position:absolute;left:180rpx;top:0;width:300rpx;height:300rpx;border:1rpx solid rgba(255,255,255,.18);transform:rotate(30deg)}.studio-letter{position:absolute;left:32rpx;bottom:12rpx;font-size:96rpx;font-family:serif;opacity:.92}.studio-zone{position:absolute;right:24rpx;top:24rpx;font-size:24rpx;letter-spacing:2rpx;color:#e8cf93}.studio-body{padding:24rpx}.studio-desc{margin:10rpx 0 20rpx}.service-preview{display:flex;align-items:center;gap:15rpx;padding:12rpx 0;border-top:1rpx solid var(--border);font-size:25rpx}.service-preview .mono-num{font-size:24rpx;color:#1d4ed8;flex-shrink:0}.studio-footer{display:flex;justify-content:space-between;gap:16rpx;margin-top:20rpx;font-size:22rpx}
