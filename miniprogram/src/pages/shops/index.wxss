.categories{white-space:nowrap;margin-bottom:20rpx}.category-inner{display:inline-flex;gap:20rpx}.category{padding:12rpx 4rpx;min-height:70rpx;color:var(--secondary);font-size:25rpx;border-bottom:3rpx solid transparent}.category.active{color:var(--navy);border-color:var(--gold);font-weight:700}.search{display:flex;gap:12rpx;margin:12rpx 0 24rpx}.search input{flex:1;min-width:0}
.studio{height:356rpx;margin-bottom:18rpx;padding:22rpx}.studio-head{height:192rpx;align-items:center}.studio-head .catalog-copy{height:100%;line-height:1.28}.studio .between{gap:8rpx}.studio .heading{font-size:30rpx}
.studio .appointment{flex:none;min-height:48rpx;padding:8rpx 18rpx;font-size:23rpx;background:var(--gold-soft);color:var(--navy)}
.studio .caption,.service-preview{font-size:23rpx}.service-previews{margin-top:12rpx;border-top:1rpx solid var(--border);padding-top:9rpx}.service-preview{display:flex;align-items:center;gap:12rpx;line-height:44rpx}.service-amount{max-width:48%;color:var(--navy)}
