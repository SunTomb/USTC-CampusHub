<launch-intro id="launch-intro" />
<view class="page">
  <zone-bar value="{{zone}}" bind:change="changeZone" />
  <view class="page-top"><view><view class="title">二手市集</view><view class="caption">先聊细节，再约地点交接。</view></view><button class="small primary" bindtap="publish">上架闲置</button></view>
  <input class="input" value="{{query}}" bindinput="search" maxlength="80" placeholder="搜索物品或分类" />
  <view class="between"><text class="section-title">正在转让</text><button wx:if="{{user}}" class="small ghost" data-url="/pages/orders/index?type=GOODS" bindtap="go">我的订单 ›</button></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" title="没有找到在售闲置" description="试试其他关键词或校区。" bind:retry="reload" />
  <view class="stack" wx:if="{{!loading && !error}}"><view class="surface listing catalog-head" wx:for="{{items}}" wx:key="id" data-url="/pages/goods/detail?id={{item.id}}" bindtap="go" hover-class="pressed">
    <catalog-photos variant="thumb" kind="GOODS" object-id="{{item.id}}" fallback-char="{{item.initial}}" tone="{{item.id % 4}}" />
    <view class="catalog-copy">
      <view class="heading single">{{item.title}}</view>
      <view class="price mono-num single">¥{{item.priceLabel}}</view>
      <view class="caption clamp">{{item.zoneLabel}} · {{item.conditionLevel || '成色未注明'}} · {{item.categoryName || '其他闲置'}}</view>
      <view class="caption single">{{item.sellerNickname || '同学'}} · {{item.tradeLocation || '交接点待约'}}</view>
    </view>
  </view></view>
</view>
<role-unlock visible="{{unlock}}" role="GOODS_PUBLISHER" bind:close="closeUnlock" bind:opened="opened" />
