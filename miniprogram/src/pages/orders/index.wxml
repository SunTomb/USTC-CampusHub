<launch-intro id="launch-intro"/><view class="page"><view class="title">我的订单</view>
<view class="desk-types"><button wx:for="{{types}}" wx:key="key" class="desk-type {{item.key===type?'chosen':''}}" data-field="type" data-key="{{item.key}}" bindtap="change">{{item.label}}</button></view>
<scroll-view scroll-x><view class="desk-stages"><button wx:for="{{stages}}" wx:key="key" class="desk-stage {{item.key===stage?'selected':''}}" data-field="stage" data-key="{{item.key}}" bindtap="change">{{item.label}}<text wx:if="{{counts[item.key]}}"> {{counts[item.key]}}</text></button></view></scroll-view>
<state-view loading="{{loading}}" error="{{!selected?error:''}}" empty="{{!rows.length}}" title="这里还没有记录" bind:retry="reload"/>
<view wx:for="{{rows}}" wx:key="key" class="desk-row" data-key="{{item.key}}" bindtap="detail"><view class="between caption"><text>{{item.kindLabel}} · {{item.roleLabel}}</text><text>{{item.statusLabel}}</text></view><view class="heading">{{item.title}}</view><view class="between"><text class="caption">{{item.dateLabel}} <text wx:if="{{item.interested}}">· {{item.interested}} 人{{item.kind==='TASK'?'报名':'想要'}}</text></text><text wx:if="{{item.amountLabel}}">{{item.goodsUrl && item.status==='COMPLETED'?'成交价 ':''}}¥{{item.amountLabel}}</text></view><button wx:if="{{item.goodsUrl}}" class="small ghost" data-url="{{item.goodsUrl}}" catchtap="go">查看商品</button></view>
<view wx:if="{{total>20}}" class="between"><button class="small plain" data-by="-1" disabled="{{page===0}}" bindtap="pageBy">上一页</button><text>{{page+1}}</text><button class="small plain" data-by="1" disabled="{{(page+1)*20>=total}}" bindtap="pageBy">下一页</button></view></view>
<bottom-sheet visible="{{!!selected}}" title="订单详情" busy="{{busy}}" bind:close="close"><view wx:if="{{selected}}"><view class="caption">{{selected.kindLabel}} · {{selected.roleLabel}} · {{selected.statusLabel}}</view><view class="heading">{{selected.title}}</view><text class="caption">{{selected.dateLabel}}<text wx:if="{{selected.goodsUrl && selected.status==='COMPLETED' && selected.amountLabel}}"> · 成交价 ¥{{selected.amountLabel}}</text></text><view wx:if="{{booking}}"><view>{{booking.shopName}} · {{booking.when}}</view><view>{{booking.note}}</view><view wx:if="{{booking.cancelReason}}">原因：{{booking.cancelReason}}</view><view wx:if="{{selected.role==='CUSTOMER' && booking.contactSnapshot}}">店主联系方式：{{booking.contactSnapshot}}</view></view>
<button wx:if="{{destination}}" class="small plain" data-url="{{destination}}" bindtap="go">{{selected.kind==='TASK'?'进入履约台':selected.goodsUrl?'查看商品':'查看详情'}} →</button><button wx:if="{{selected.kind==='PROJECT' && (selected.status==='DRAFT'||selected.status==='REJECTED')}}" class="small plain" data-url="/pages/showcase/publish?id={{selected.objectId}}" bindtap="go">编辑宣传</button><button wx:if="{{selected.kind==='PROJECT' && (selected.status==='APPROVED'||selected.status==='PENDING_REVIEW'||selected.status==='DRAFT'||selected.status==='REJECTED')}}" class="small plain" disabled="{{busy}}" bindtap="closeProject">结束宣传</button><view class="desk-buttons"><button wx:for="{{actions}}" wx:key="value" class="small plain" data-mode="{{item.value}}" bindtap="choose">{{item.label}}</button><button wx:if="{{selected.canReview}}" class="small primary" data-mode="review" bindtap="choose">写评价</button><button wx:if="{{selected.canComplain}}" class="small plain" data-mode="complaint" bindtap="choose">投诉此单</button><text class="caption" wx:if="{{selected.reviewed}}">已评价</text><text class="caption" wx:if="{{selected.complained}}">已投诉</text></view>
<view wx:if="{{mode==='review'}}" class="desk-buttons"><button aria-label="{{item}}星" wx:for="{{starList}}" wx:key="*this" class="desk-star" data-star="{{item}}" bindtap="star">{{item<=stars?'★':'☆'}}</button></view><input wx:if="{{mode==='complaint'||mode==='reject'||mode==='cancel'}}" class="input" placeholder="原因" maxlength="120" value="{{reason}}" data-field="reason" bindinput="field"/><textarea wx:if="{{mode==='complaint'||mode==='review'}}" placeholder="补充说明（选填）" maxlength="1000" value="{{note}}" data-field="note" bindinput="field"/><view wx:if="{{error}}" class="error">{{error}}</view></view><view slot="footer"><button wx:if="{{mode}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="submit">{{mode==='review'?'提交评价':mode==='complaint'?'提交投诉':'确认更新预约'}}</button></view></bottom-sheet>
