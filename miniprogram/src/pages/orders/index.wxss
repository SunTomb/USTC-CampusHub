.desk-types,.desk-buttons,.desk-stages{display:flex;align-items:center;gap:10rpx}.desk-types{margin:24rpx 0}.desk-type,.desk-stage,.desk-star{padding:12rpx;min-height:66rpx;border:0;background:none;color:var(--ink);font-size:26rpx}.desk-type.chosen{border-bottom:4rpx solid var(--navy);border-radius:0;font-weight:700}.desk-stages{display:inline-flex}.desk-stage{color:var(--navy);white-space:nowrap}.desk-stage.selected{background:#e5ebf0}.desk-row{padding:26rpx 0;border-bottom:1rpx solid #d4dae0}.desk-row .heading{margin:10rpx 0}.desk-buttons{flex-wrap:wrap;margin:16rpx 0}.desk-star{color:#855c14;font-size:42rpx}
