<launch-intro id="launch-intro" />
<view class="page auth-page"><view class="auth-brand"><image src="/assets/brand.png" mode="aspectFit"/><view><view class="heading">蜗壳同路 CampusHub</view><text class="caption">用校园邮箱，连接同学</text></view></view>
<view wx:if="{{recovery}}" class="surface stack"><view class="heading">恢复登录</view><text class="caption">{{sessionError}}</text><button class="primary" bindtap="retrySession" loading="{{busy}}" disabled="{{busy}}">重试验证登录</button><button class="plain" bindtap="otherAccount" disabled="{{busy}}">使用其他账号</button></view>
<block wx:else><view class="segmented"><view class="segment {{tab === 'login' ? 'active' : ''}}" data-tab="login" bindtap="changeTab">账号登录</view><view class="segment {{tab === 'register' ? 'active' : ''}}" data-tab="register" bindtap="changeTab">校园邮箱注册</view></view><view wx:if="{{error && !protocolOpen}}" class="error">{{error}}</view><view wx:if="{{tab === 'login'}}"><view class="field"><text class="field-label">用户名 / 校园邮箱</text><input class="input" value="{{loginForm.username}}" data-field="loginForm.username" bindinput="field" maxlength="128" placeholder="你的用户名或校园邮箱" /></view><view class="field"><text class="field-label">密码</text><input class="input" password value="{{loginForm.password}}" data-field="loginForm.password" bindinput="field" maxlength="72" placeholder="输入登录密码" confirm-type="done" bindconfirm="submitLogin" /></view><button class="primary" bindtap="submitLogin" disabled="{{busy}}" loading="{{busy}}">登录并继续</button></view>
<view wx:else><view class="field"><text class="field-label">校园邮箱</text><input class="input" value="{{registerForm.email}}" data-field="registerForm.email" bindinput="field" maxlength="128" placeholder="student@mail.ustc.edu.cn"/><text class="form-help">支持 edu.cn 校园邮箱；邮箱验证不是实名认证。</text></view><view class="field"><text class="field-label">用户名</text><input class="input" value="{{registerForm.username}}" data-field="registerForm.username" bindinput="field" maxlength="64" placeholder="3–64 位字母、数字或下划线" /></view><view class="field"><text class="field-label">邮箱验证码</text><view class="code-row"><input class="input" type="number" value="{{registerForm.emailCode}}" data-field="registerForm.emailCode" bindinput="field" maxlength="6" placeholder="6 位验证码"/><button class="small plain" bindtap="sendCode" loading="{{sending}}" disabled="{{sending || seconds > 0}}">{{seconds > 0 ? seconds + '秒后重发' : '获取验证码'}}</button></view></view><view class="field"><text class="field-label">设置密码</text><input class="input" password value="{{registerForm.password}}" data-field="registerForm.password" bindinput="field" maxlength="72" placeholder="8–72 位字符"/></view><view class="field"><text class="field-label">微信号（与 QQ 至少填一项）</text><input class="input" value="{{registerForm.wechatContact}}" data-field="registerForm.wechatContact" bindinput="field" maxlength="64" placeholder="便于达成预约后联络"/></view><view class="field"><text class="field-label">QQ 号（选填）</text><input class="input" value="{{registerForm.qqContact}}" data-field="registerForm.qqContact" bindinput="field" maxlength="32" placeholder="你的 QQ 号"/></view><button class="primary" bindtap="submitRegistration" disabled="{{busy}}" loading="{{busy}}">验证邮箱并注册</button></view></block><view class="auth-foot"><text class="link" bindtap="openProtocol">阅读用户服务协议</text><text class="muted">独立学生项目，不代表学校或机构。请勿公开取件码、密码等私人信息。</text></view></view>
<bottom-sheet visible="{{protocolOpen}}" title="{{protocol.title || '用户服务协议'}}" bind:close="closeProtocol"><state-view loading="{{loading}}" error="{{error}}" bind:retry="openProtocol"/><view wx:if="{{protocol}}"><text class="pill gold">{{protocol.version}}</text><view class="content protocol-copy">{{protocol.content}}</view></view><view slot="footer"><button class="plain" bindtap="closeProtocol">关闭阅读</button></view></bottom-sheet>
