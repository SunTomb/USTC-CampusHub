.pass-card{position:relative;overflow:hidden;min-height:300rpx;padding:32rpx;background:linear-gradient(125deg,#0b1626,#16325b);border-radius:28rpx;color:#fff}.pass-border{position:absolute;inset:12rpx;border:1rpx solid rgba(198,146,44,.4);border-radius:20rpx;pointer-events:none}.pass-watermark{position:absolute;width:180rpx;height:180rpx;right:-10rpx;top:10rpx;opacity:.12}.pass-brand{color:#e3c47d;font-weight:600;font-size:25rpx;letter-spacing:2rpx}.pass-brand text{font-size:21rpx;letter-spacing:0;margin-left:8rpx}.pass-name{font-size:44rpx;font-weight:700;margin-top:28rpx;max-width:85%;word-break:break-all}.pass-email{font-size:23rpx;color:#c8d2e0;margin-top:6rpx;word-break:break-all}.pass-bottom{display:flex;gap:16rpx;justify-content:space-between;margin-top:26rpx;font-size:22rpx;color:#e3c47d}.guest-actions{display:flex;flex-direction:column;gap:20rpx;margin:28rpx 0}.pass-tabs{white-space:nowrap;margin:22rpx 0}.pass-tab-inner{display:flex;gap:8rpx}.pass-tab{display:inline-flex;flex:1;gap:8rpx;align-items:center;justify-content:center;padding:18rpx 12rpx;min-height:76rpx;font-size:26rpx;border-bottom:3rpx solid transparent;color:var(--secondary)}.pass-tab.active{color:var(--navy);font-weight:700;border-color:var(--gold)}.role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.role-tile{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10rpx;padding:24rpx 8rpx;border:1rpx solid var(--border);border-radius:20rpx;background:#fff}.role-seal{display:flex;align-items:center;justify-content:center;border:1rpx solid #c7ccd4;border-radius:12rpx;width:64rpx;height:64rpx;font-family:serif;font-size:35rpx;color:#89929e;transform:rotate(-5deg)}.lit .role-seal{border-color:var(--gold);color:#a5761f;background:var(--gold-soft)}.role-name{font-weight:600;font-size:24rpx}.role-status{font-size:21rpx;color:var(--secondary)}.record{background:#fff;padding:24rpx;border:1rpx solid var(--border);border-radius:20rpx;display:flex;flex-direction:column;gap:14rpx;margin:16rpx 0}.record-title{font-weight:600;font-size:28rpx;min-width:0;flex:1}.notice-row{padding:24rpx 0;display:flex;flex-direction:column;gap:12rpx;border-bottom:1rpx solid var(--border)}.unread-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--gold);flex-shrink:0}.protocol-copy{font-size:26rpx;margin-top:24rpx}.order-status{display:flex;gap:20rpx;align-items:center;margin:22rpx 0}.contact-button{margin:20rpx 0}
