<launch-intro id="launch-intro" about-visible="{{aboutOpen}}" bind:close="closeAbout" />
<view class="page pass-page">
  <view class="pass-card"><view class="pass-border"></view><image src="/assets/brand.png" class="pass-watermark" mode="aspectFit"/><view class="pass-brand">蜗壳同路 <text>CampusHub</text></view><view class="pass-name">{{profile.nickname || user.nickname || '同学，你好'}}</view><view class="pass-email">{{profile.email || (user ? '个人主页' : '登录后查看自己的个人主页')}}</view><view class="pass-bottom"><text>{{user ? '信用分 ' + creditLabel : '校园互助'}}</text><text wx:if="{{profile}}">{{profile.wechatContact || profile.qqContact ? '联络方式已填写' : '尚未填写联络方式'}}</text></view></view>
  <view wx:if="{{!user}}" class="guest-actions"><button class="primary" bindtap="login">{{error ? '验证登录 / 重试' : '校园邮箱登录或注册'}}</button><view wx:if="{{error}}" class="error">{{error}}</view><view class="caption">公开内容可以直接浏览。接单、预约和发布前需登录。</view></view>
  <block wx:else>
    <view class="order-entry"><view class="between"><text class="heading">我的订单</text><button class="small ghost" data-url="/pages/orders/index" bindtap="go">全部 ›</button></view><view class="order-shortcuts"><button wx:for="{{shortcuts}}" wx:key="key" class="order-shortcut" data-url="/pages/orders/index?stage={{item.key}}" bindtap="go"><view class="order-symbol"><image src="/assets/order-{{item.key}}.svg" mode="aspectFit"/><text wx:if="{{orderCounts[item.key]>0}}" class="order-badge">{{orderCounts[item.key]>99?'99+':orderCounts[item.key]}}</text></view><text>{{item.label}}</text></button></view></view>
    <view class="segmented"><view class="segment pass-tab {{section === 'pass' ? 'active' : ''}}" data-section="pass" bindtap="switchSection">身份</view><view class="segment pass-tab {{section === 'notices' ? 'active' : ''}}" data-section="notices" bindtap="switchSection">通知<text wx:if="{{unread}}" class="badge">{{unread}}</text></view></view>
    <state-view loading="{{loading}}" error="{{!profileOpen && !passwordOpen && !protocolOpen ? error : ''}}" bind:retry="reload" />
    <view wx:if="{{section === 'pass'}}"><view class="role-grid"><view wx:for="{{roleCards}}" wx:key="value" class="role-tile {{item.active ? 'lit' : ''}}" data-role="{{item.value}}" bindtap="openRole"><view class="role-seal">{{item.seal}}</view><view class="role-name">{{item.label}}</view><view class="role-status">{{item.statusLabel}}</view></view></view><view class="disabled-note">开店申请由站务审核。</view><view class="action-list"><view class="action-row" bindtap="openProfile"><text>个人信息与账号</text><text>编辑 →</text></view><view class="action-row" bindtap="openProtocol"><text>用户服务协议</text><text>查看 →</text></view><view class="action-row" bindtap="logout"><text>退出当前账号</text><text>→</text></view></view><view class="muted">店铺资料与经营管理请在网页端操作。</view></view>
    <view wx:elif="{{section === 'notices'}}">
      <view wx:if="{{notices.length}}" class="between notice-bar"><text class="caption">{{unread ? '未读 ' + unread + ' 条' : '已全部阅读'}}</text><button wx:if="{{unread}}" class="small plain" bindtap="readAllNotices" disabled="{{busy}}" loading="{{busy}}">一键已读</button></view>
      <view wx:for="{{notices}}" wx:key="id" class="notice-row" data-id="{{item.id}}" bindtap="readNotice"><view class="between"><text class="record-title">{{item.title}}</text><text wx:if="{{item.unread}}" class="unread-dot"></text></view><view class="content caption">{{item.content}}</view><text class="muted">{{item.dateLabel}}{{item.unread ? ' · 点按标为已读' : ''}}</text></view><state-view empty="{{!loading && !notices.length}}" title="暂时没有新消息" description="任务、预约和身份进度会在这里通知你。"/></view>
  </block>
  <view wx:if="{{!user}}" class="action-row" bindtap="openProtocol"><text>用户服务协议</text><text>查看 →</text></view>
  <view id="about-entry" class="action-row" bindtap="openAbout"><text>关于与备案</text><text>查看 →</text></view>
</view>
<role-unlock id="pass-role" visible="{{unlock}}" role="{{role}}" bind:close="closeRole" bind:opened="roleOpened" />
<bottom-sheet visible="{{profileOpen}}" title="个人信息" busy="{{busy}}" bind:close="closeProfile"><view class="field"><text class="field-label">用户名</text><input class="input" value="{{profileForm.username}}" data-field="profileForm.username" bindinput="field" maxlength="64" /></view><view class="field"><text class="field-label">昵称</text><input class="input" value="{{profileForm.nickname}}" data-field="profileForm.nickname" bindinput="field" maxlength="64" /></view><view class="caption">校园邮箱：{{profile.email}}</view><view class="field"><text class="field-label">微信号（与 QQ 至少填一项）</text><input class="input" value="{{profileForm.wechatContact}}" data-field="profileForm.wechatContact" bindinput="field" maxlength="120" placeholder="达成预约或接单后用于联系" /></view><view class="field"><text class="field-label">QQ 号（选填）</text><input class="input" value="{{profileForm.qqContact}}" data-field="profileForm.qqContact" bindinput="field" maxlength="60" /></view><view class="form-help">仅在接单或预约后向对方展示</view><view class="action-row" bindtap="openPassword"><text>修改密码</text><text>→</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer" class="stack"><button class="primary" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">保存用户名与昵称</button><button class="plain" bindtap="saveContacts" loading="{{busy}}" disabled="{{busy}}">保存联系方式</button></view></bottom-sheet>
<bottom-sheet visible="{{passwordOpen}}" title="修改密码" busy="{{busy}}" bind:close="closePassword"><view class="field"><text class="field-label">当前密码</text><input class="input" password value="{{passwordForm.currentPassword}}" data-field="passwordForm.currentPassword" bindinput="field" maxlength="72" /></view><view class="field"><text class="field-label">新密码</text><input class="input" password value="{{passwordForm.newPassword}}" data-field="passwordForm.newPassword" bindinput="field" maxlength="72" placeholder="8–72 位字符" /></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer"><button class="primary" bindtap="savePassword" loading="{{busy}}" disabled="{{busy}}">更新密码并退出本机账号</button></view></bottom-sheet>
<bottom-sheet visible="{{protocolOpen}}" title="{{protocol.title || '用户服务协议'}}" bind:close="closeProtocol"><state-view loading="{{loading}}" error="{{error}}" bind:retry="openProtocol"/><view wx:if="{{protocol}}"><text class="pill gold">{{protocol.version}}</text><view class="content protocol-copy">{{protocol.content}}</view></view><view slot="footer"><button class="plain" bindtap="closeProtocol">关闭阅读</button></view></bottom-sheet>
