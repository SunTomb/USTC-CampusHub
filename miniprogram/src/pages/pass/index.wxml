<launch-intro id="launch-intro" about-visible="{{aboutOpen}}" bind:close="closeAbout" />
<view class="page pass-page">
  <view class="pass-card"><view class="pass-border"></view><image src="/assets/brand.png" class="pass-watermark" mode="aspectFit"/><view class="pass-brand">蜗壳同路 <text>CampusHub</text></view><view class="pass-name">{{profile.nickname || user.nickname || '同学，你好'}}</view><view class="pass-email">{{profile.email || (user ? '校园通行证' : '登录后查看自己的校园通行证')}}</view><view class="pass-bottom"><text>{{user ? '信用分 ' + creditLabel : '独立学生项目 · 校园互助'}}</text><text wx:if="{{profile}}">{{profile.wechatContact || profile.qqContact ? '联络方式已填写' : '尚未填写联络方式'}}</text></view></view>
  <view wx:if="{{!user}}" class="guest-actions"><button class="primary" bindtap="login">{{error ? '验证登录 / 重试' : '校园邮箱登录或注册'}}</button><view wx:if="{{error}}" class="error">{{error}}</view><view class="caption">公开内容可以直接浏览。接单、预约和发布前需登录。</view></view>
  <block wx:else>
    <scroll-view scroll-x class="pass-tabs" show-scrollbar="{{false}}"><view class="pass-tab-inner"><view class="pass-tab {{section === 'pass' ? 'active' : ''}}" data-section="pass" bindtap="switchSection">身份</view><view class="pass-tab {{section === 'tasks' ? 'active' : ''}}" data-section="tasks" bindtap="switchSection">跑腿</view><view class="pass-tab {{section === 'orders' ? 'active' : ''}}" data-section="orders" bindtap="switchSection">预约</view><view class="pass-tab {{section === 'posts' ? 'active' : ''}}" data-section="posts" bindtap="switchSection">宣传</view><view class="pass-tab {{section === 'notices' ? 'active' : ''}}" data-section="notices" bindtap="switchSection">通知 <text wx:if="{{unread}}" class="badge">{{unread}}</text></view></view></scroll-view>
    <state-view loading="{{loading}}" error="{{!profileOpen && !passwordOpen && !orderOpen && !protocolOpen ? error : ''}}" bind:retry="reload" />
    <view wx:if="{{section === 'pass'}}"><view class="role-grid"><view wx:for="{{roleCards}}" wx:key="value" class="role-tile {{item.active ? 'lit' : ''}}" data-role="{{item.value}}" bindtap="openRole"><view class="role-seal">{{item.seal}}</view><view class="role-name">{{item.label}}</view><view class="role-status">{{item.statusLabel}}</view></view></view><view class="disabled-note">已有身份继续保留，无需补签。店主理人需站务核验；闲置业务首版仍在网页使用。</view><view class="action-list"><view class="action-row" bindtap="openProfile"><text>个人信息与账号</text><text>编辑 →</text></view><view class="action-row" bindtap="openProtocol"><text>用户服务协议</text><text>查看 →</text></view><view class="action-row" bindtap="logout"><text>退出当前账号</text><text>→</text></view></view><view class="muted">商家开店资料、完整经营与站务管理在网页端维护；这里可处理轻量预约。</view></view>
    <view wx:elif="{{section === 'tasks'}}"><view class="section-title">我的接单与报名</view><view wx:for="{{tasks}}" wx:key="id" class="record" data-url="/pages/tasks/detail?id={{item.taskId}}" bindtap="go"><view class="between"><text class="record-title single">{{item.taskTitle}}</text><text class="pill">{{item.statusLabel}}</text></view><text class="caption">{{item.dateLabel}} · 查看任务 →</text></view><state-view empty="{{!loading && !tasks.length}}" title="还没有接单或报名" description="去跑腿大厅找一程顺路。"/><view class="section-title">我发布的跑腿</view><text class="muted">按当前账号查看跨设备发布记录。</text><view wx:for="{{publishedTasks}}" wx:key="id" class="record" data-url="/pages/tasks/detail?id={{item.id}}" bindtap="go"><view class="between"><text class="record-title single">{{item.title}}</text><text class="pill">{{item.statusLabel}}</text></view><text class="caption">{{item.originLabel}} → {{item.destinationLabel}}</text></view></view>
    <view wx:elif="{{section === 'orders'}}"><view class="segmented"><view class="segment {{!providerMode ? 'active' : ''}}" data-provider="no" bindtap="toggleOrders">我预约的</view><view class="segment {{providerMode ? 'active' : ''}}" data-provider="yes" bindtap="toggleOrders">店主接单</view></view><view wx:for="{{orders}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="showOrder"><view class="between"><text class="record-title single">{{item.serviceItemTitle}}</text><text class="pill blue">{{item.statusLabel}}</text></view><view class="caption">{{item.shopName}} · {{item.dateLabel}}</view><view class="between caption"><text>约定 ¥{{item.amountLabel}}</text><text>查看预约 →</text></view></view><state-view empty="{{!loading && !orders.length}}" title="暂时没有预约记录" description="有新的预约后，会在这里显示。"/></view>
    <view wx:elif="{{section === 'posts'}}"><view class="page-top"><text class="section-title">我的宣传</text><button class="small plain" data-url="/pages/showcase/publish" bindtap="go">＋ 新宣传</button></view><view wx:for="{{posts}}" wx:key="id" class="record" data-url="/pages/showcase/detail?id={{item.id}}" bindtap="go"><view class="between"><text class="record-title single">{{item.title}}</text><text class="pill">{{item.statusLabel}}</text></view><text class="caption">{{item.typeLabel}}</text><button wx:if="{{item.status === 'DRAFT' || item.status === 'REJECTED'}}" class="small plain" data-url="/pages/showcase/publish?id={{item.id}}" catchtap="go">编辑与提交</button></view><state-view empty="{{!loading && !posts.length}}" title="你的宣传还没有发布" description="从一条招募或一件作品开始。"/></view>
    <view wx:elif="{{section === 'notices'}}"><view wx:for="{{notices}}" wx:key="id" class="notice-row" data-id="{{item.id}}" bindtap="readNotice"><view class="between"><text class="record-title">{{item.title}}</text><text wx:if="{{item.unread}}" class="unread-dot"></text></view><view class="content caption">{{item.content}}</view><text class="muted">{{item.dateLabel}}{{item.unread ? ' · 点按标为已读' : ''}}</text></view><state-view empty="{{!loading && !notices.length}}" title="暂时没有新消息" description="任务、预约和身份进度会在这里通知你。"/></view>
  </block>
  <view wx:if="{{!user}}" class="action-row" bindtap="openProtocol"><text>用户服务协议</text><text>查看 →</text></view>
  <view id="about-entry" class="action-row" bindtap="openAbout"><text>关于与备案</text><text>查看 →</text></view>
</view>
<role-unlock id="pass-role" visible="{{unlock}}" role="{{role}}" bind:close="closeRole" bind:opened="roleOpened" />
<bottom-sheet visible="{{profileOpen}}" title="个人信息" busy="{{busy}}" bind:close="closeProfile"><view class="field"><text class="field-label">用户名</text><input class="input" value="{{profileForm.username}}" data-field="profileForm.username" bindinput="field" maxlength="64" /></view><view class="field"><text class="field-label">昵称</text><input class="input" value="{{profileForm.nickname}}" data-field="profileForm.nickname" bindinput="field" maxlength="64" /></view><view class="caption">校园邮箱：{{profile.email}}</view><view class="field"><text class="field-label">微信号（与 QQ 至少填一项）</text><input class="input" value="{{profileForm.wechatContact}}" data-field="profileForm.wechatContact" bindinput="field" maxlength="120" placeholder="达成预约或接单后用于联系" /></view><view class="field"><text class="field-label">QQ 号（选填）</text><input class="input" value="{{profileForm.qqContact}}" data-field="profileForm.qqContact" bindinput="field" maxlength="60" /></view><view class="form-help">联系方式只在相关业务规则允许时展示，不会公开列出。</view><view class="action-row" bindtap="openPassword"><text>修改密码</text><text>→</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer" class="stack"><button class="primary" bindtap="saveProfile" loading="{{busy}}" disabled="{{busy}}">保存用户名与昵称</button><button class="plain" bindtap="saveContacts" loading="{{busy}}" disabled="{{busy}}">保存联系方式</button></view></bottom-sheet>
<bottom-sheet visible="{{passwordOpen}}" title="修改密码" busy="{{busy}}" bind:close="closePassword"><view class="field"><text class="field-label">当前密码</text><input class="input" password value="{{passwordForm.currentPassword}}" data-field="passwordForm.currentPassword" bindinput="field" maxlength="72" /></view><view class="field"><text class="field-label">新密码</text><input class="input" password value="{{passwordForm.newPassword}}" data-field="passwordForm.newPassword" bindinput="field" maxlength="72" placeholder="8–72 位字符" /></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer"><button class="primary" bindtap="savePassword" loading="{{busy}}" disabled="{{busy}}">更新密码并退出本机账号</button></view></bottom-sheet>
<bottom-sheet visible="{{protocolOpen}}" title="{{protocol.title || '用户服务协议'}}" bind:close="closeProtocol"><state-view loading="{{loading}}" error="{{error}}" bind:retry="openProtocol"/><view wx:if="{{protocol}}"><text class="pill gold">{{protocol.version}}</text><view class="content protocol-copy">{{protocol.content}}</view></view><view slot="footer"><button class="plain" bindtap="closeProtocol">关闭阅读</button></view></bottom-sheet>
<bottom-sheet id="order-sheet" visible="{{orderOpen}}" title="预约进度" busy="{{busy}}" bind:close="closeOrder"><view class="heading">{{selectedOrder.serviceItemTitle}}</view><view class="caption">{{selectedOrder.shopName}} · {{selectedOrder.dateLabel}}</view><view class="order-status"><text class="pill blue">{{selectedOrder.statusLabel}}</text><text class="mono-num">¥{{selectedOrder.amountLabel}}</text></view><view class="content">{{selectedOrder.note || '没有补充需求'}}</view><view wx:if="{{selectedOrder.cancelReason}}" class="notice">{{selectedOrder.cancelReason}}</view><button wx:for="{{selectedOrder.contacts}}" wx:key="label" class="plain contact-button" data-index="{{index}}" bindtap="copyContact">{{item.label}}</button><view wx:if="{{selectedOrder.status === 'REQUESTED' || selectedOrder.status === 'ACCEPTED'}}" class="field"><text class="field-label">取消/婉拒原因（仅相应操作需填写）</text><textarea value="{{actionReason}}" data-field="actionReason" bindinput="field" maxlength="500" placeholder="如需取消，请给对方一个清楚的说明" /></view><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer" class="stack"><button wx:for="{{selectedOrder.actions}}" wx:key="value" class="{{item.value === 'reject' || item.value === 'cancel' ? 'plain' : ''}}" data-action="{{item.value}}" bindtap="orderAction" disabled="{{busy}}" loading="{{busy}}">{{item.label}}</button><text wx:if="{{!selectedOrder.actions.length}}" class="caption">本次预约当前没有可执行的操作。</text></view></bottom-sheet>
