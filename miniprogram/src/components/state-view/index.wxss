.state-panel{display:flex;align-items:center;flex-direction:column;text-align:center;gap:18rpx;padding:60rpx 32rpx;margin:20rpx 0;border:1rpx dashed rgba(15,23,42,.15);border-radius:22rpx;background:rgba(255,255,255,.5)}.paper-mark{height:64rpx;width:64rpx;border:1rpx solid #c6922c;border-radius:14rpx;color:#a57722;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:34rpx;transform:rotate(-6deg)}.loading-dot{width:16rpx;height:16rpx;border-radius:50%;background:#c6922c;animation:pulse 1s ease-in-out infinite}@keyframes pulse{50%{opacity:.3}}
