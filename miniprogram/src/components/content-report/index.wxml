<button class="small ghost" bindtap="start">举报{{kind==='SHOP'?'店铺':'宣传'}}</button><bottom-sheet visible="{{open}}" title="举报原因" busy="{{busy}}" bind:close="close"><input class="input" placeholder="原因" maxlength="120" data-field="reason" bindinput="field" value="{{reason}}"/><textarea placeholder="补充说明（选填）" maxlength="1000" data-field="description" bindinput="field" value="{{description}}"/><view wx:if="{{error}}" class="error">{{error}}</view><view slot="footer"><button class="primary" disabled="{{busy||!reason}}" bindtap="submit">提交举报</button></view></bottom-sheet>
