<button wx:if="{{count}}" class="small ghost" bindtap="toggle">{{score}} 分 · {{count}} 条评价 {{open?'收起':'查看'}}</button><text wx:else class="caption">暂无评价</text><block wx:if="{{open}}"><view wx:for="{{rows}}" wx:key="index" class="entry"><text class="caption">{{item.nickname}} · {{item.rating}} 星 · {{item.date}}</text><view>{{item.content}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error||rows.length<total}}" class="small plain" disabled="{{busy}}" bindtap="more">{{error?'重试':'更多评价'}}</button></block>
