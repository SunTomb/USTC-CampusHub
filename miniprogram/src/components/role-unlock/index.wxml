<bottom-sheet id="role-sheet" visible="{{visible}}" title="{{protocol.title || '阅读身份协议'}}" busy="{{busy}}" bind:close="close">
  <state-view loading="{{loading}}" error="{{error && !protocol ? error : ''}}" bind:retry="reload" />
  <block wx:if="{{protocol}}"><view class="between"><text class="pill gold">免保证金</text><text class="caption">{{protocol.version}}</text></view><view class="protocol-copy">{{protocol.content}}</view></block>
  <view slot="footer"><view wx:if="{{error && protocol}}" class="error">{{error}}<text class="link" bindtap="reload"> 重新加载协议</text></view><checkbox-group bindchange="accept"><label class="check-row"><checkbox value="agree" checked="{{accepted}}" disabled="{{busy || !protocol}}" color="#8C4A27"/><text>我已阅读并同意上述协议</text></label></checkbox-group><button class="primary" disabled="{{!accepted || !protocol || loading || busy}}" loading="{{busy}}" bindtap="submit">{{merchant ? '同意协议并申请核验' : '同意协议并开通'}}</button></view>
</bottom-sheet>
