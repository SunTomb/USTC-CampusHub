<view wx:if="{{variant === 'thumb' || variant === 'thumb-sm' || (!variant && compact)}}" class="cover-square {{variant === 'thumb-sm' ? 'cover-small' : ''}} tone-{{tone}}">
  <view wx:if="{{images.length}}" class="cover-photo" data-src="{{images[0].src}}" catchtap="preview">
    <image class="photo" src="{{images[0].src}}" mode="aspectFill"/>
    <text wx:if="{{totalCount > 1}}" class="cover-count">{{totalCount}}图</text>
  </view>
  <view wx:else class="cover-fallback"><text class="cover-initial">{{fallbackChar || '图'}}</text><text wx:if="{{fallbackSub}}" class="cover-sub single">{{fallbackSub}}</text></view>
</view>
<view wx:elif="{{editable || (variant === 'detail' ? totalCount > 1 : totalCount > 0) || error}}" class="gallery">
  <text wx:if="{{editable}}" class="caption">{{kind === 'SHOP' ? '店铺封面' : '展示图片'}}（选填）</text>
  <view class="tiles">
    <view wx:for="{{images}}" wx:key="id" class="tile-column">
      <view class="tile" data-src="{{item.src}}" catchtap="preview"><image class="photo" src="{{item.src}}" mode="aspectFill"/></view>
      <button wx:if="{{editable}}" class="small plain" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">移除</button>
    </view>
    <view wx:for="{{queue}}" wx:key="key" class="tile-column">
      <view class="tile" data-src="{{item.path}}" catchtap="preview"><image class="photo" src="{{item.path}}" mode="aspectFill"/></view>
      <button class="small plain" data-key="{{item.key}}" disabled="{{busy}}" bindtap="drop">移除</button>
    </view>
  </view>
  <view wx:if="{{editable}}" class="gallery-actions">
    <button wx:if="{{totalCount + queue.length < (kind === 'SHOP' ? 1 : 3)}}" class="small plain" disabled="{{busy}}" bindtap="pick">选择照片</button>
    <button wx:if="{{queue.length && objectId}}" class="small primary" disabled="{{busy}}" bindtap="retry">上传所选照片</button>
  </view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
</view>
<root-portal wx:if="{{previewSrc}}"><view class="preview-screen" catchtap="closePreview"><image class="preview-photo" src="{{previewSrc}}" mode="aspectFit"/><text>点击关闭</text></view></root-portal>
