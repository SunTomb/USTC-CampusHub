<view wx:if="{{editable || images.length || queue.length || error}}" class="gallery"><text wx:if="{{editable}}" class="caption">{{kind==='SHOP'?'店铺封面':'展示图片'}}（选填）</text><view class="thumbs {{compact?'compact':''}}"><view wx:for="{{images}}" wx:key="id"><image src="{{item.src}}" mode="aspectFill"/><button wx:if="{{editable}}" class="small plain" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">移除</button></view><view wx:for="{{queue}}" wx:key="key"><image src="{{item.path}}" mode="aspectFill"/><button class="small plain" data-key="{{item.key}}" disabled="{{busy}}" bindtap="drop">移除</button></view></view><button wx:if="{{editable && images.length+queue.length<(kind==='SHOP'?1:3)}}" class="small plain" disabled="{{busy}}" bindtap="pick">选择照片</button><button wx:if="{{editable && queue.length && objectId}}" class="small primary" disabled="{{busy}}" bindtap="retry">上传所选照片</button><text wx:if="{{error}}" class="error">{{error}}</text></view>
