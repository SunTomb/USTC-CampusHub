.sheet-layer{position:fixed;inset:0;z-index:5000}.sheet-mask{position:absolute;inset:0;background:rgba(11,22,38,.48)}.sheet{position:absolute;left:0;right:0;bottom:0;height:80vh;max-height:85vh;background:#f7f5f0;border-radius:32rpx 32rpx 0 0;display:flex;flex-direction:column;animation:sheet-in .18s ease-out}.sheet-handle{height:7rpx;width:68rpx;background:#d4d5d4;border-radius:99rpx;margin:16rpx auto 0;flex-shrink:0}.sheet-heading{display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx;gap:20rpx;flex-shrink:0}.sheet-close{background:transparent;color:#526075;border:0;min-width:80rpx;min-height:80rpx;padding:0;font-size:48rpx}.sheet-scroll{flex:1;height:0;min-height:0}.sheet-body{padding:4rpx 28rpx 28rpx}.sheet-footer{padding:20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid rgba(15,23,42,.08);flex-shrink:0}@keyframes sheet-in{from{transform:translateY(40rpx);opacity:.6}to{transform:translateY(0);opacity:1}}
