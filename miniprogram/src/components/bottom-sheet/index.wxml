<view wx:if="{{visible}}" class="sheet-layer" catchtouchmove="noop">
  <view class="sheet-mask" bindtap="close"></view>
  <view class="sheet" role="dialog" aria-modal="true" aria-label="{{title}}">
    <view class="sheet-handle"></view>
    <view class="sheet-heading"><text class="heading">{{title}}</text><button class="sheet-close" bindtap="close" disabled="{{busy}}" aria-label="关闭">×</button></view>
    <scroll-view scroll-y class="sheet-scroll" enhanced show-scrollbar="{{false}}"><view class="sheet-body"><slot></slot></view></scroll-view>
    <view class="sheet-footer"><slot name="footer"></slot></view>
  </view>
</view>
