<scroll-view scroll-x class="zone-strip" enhanced show-scrollbar="{{false}}"><view class="zone-inner"><view wx:if="{{includeAll}}" class="zone {{value === '' ? 'chosen' : ''}}" data-value="" bindtap="change" role="button">全部校区</view><view wx:for="{{zones}}" wx:key="value" class="zone {{value === item.value ? 'chosen' : ''}}" data-value="{{item.value}}" bindtap="change" role="button">{{item.label}}</view></view></scroll-view>
